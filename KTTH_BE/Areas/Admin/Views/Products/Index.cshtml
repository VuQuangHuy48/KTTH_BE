@model IEnumerable<KTTH_BE.Models.Product>
@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="margin-top: 20px;">QUẢN LÝ SẢN PHẨM</h2>

<p style="margin-bottom: 15px;">
    @Html.ActionLink("Thêm mới sản phẩm", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <tr class="bg-success">
        <th>Hình ảnh</th>
        <th>Tên sản phẩm</th>
        <th>Đơn giá</th>
        <th>Mô tả</th>
        <th>Danh mục</th>
        <th>Thao tác</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default_img.png")" style="height:60px; width:60px; object-fit:cover;" />
            </td>
            <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
            <td>@item.ProductPrice.ToString("N0") VNĐ</td>
            <td>@Html.DisplayFor(modelItem => item.ProductDescription)</td>
            <td>@Html.DisplayFor(modelItem => item.Category.CategoryName)</td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-warning btn-xs" }) |
                @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-info btn-xs" }) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-danger btn-xs" })
            </td>
        </tr>
    }

</table>