@model KTTH_BE.Models.ViewModel.CheckoutVM
@{ ViewBag.Title = "Đặt hàng"; }

<h2>ĐẶT HÀNG</h2>
@using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-md-2">Địa chỉ giao hàng</label>
            <div class="col-md-10">@Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control" })</div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-2">Phương thức giao</label>
            <div class="col-md-10">
                @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng nhanh", new { @checked = "checked" }) Giao hàng nhanh <br />
                @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng tiết kiệm") Giao hàng tiết kiệm
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-2">Thanh toán</label>
            <div class="col-md-10">
                @Html.RadioButtonFor(m => m.PaymentMethod, "Tiền mặt", new { @checked = "checked" }) Tiền mặt <br />
                @Html.RadioButtonFor(m => m.PaymentMethod, "Chuyển khoản") Chuyển khoản
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-2">Tổng tiền</label>
            <div class="col-md-10"><h4>@Model.TotalAmount.ToString("N0") VNĐ</h4></div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10"><input type="submit" value="Xác nhận đặt hàng" class="btn btn-success" /></div>
        </div>
    </div>
}